# VPS: set your exact HTTPS origin, with no trailing slash.
APP_ORIGIN=https://atlas.example.org
WEB_PORT=8081
# Only local development may set this true with a localhost APP_ORIGIN.
ALLOW_INSECURE_LOCALHOST=false
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Server-only photo recognition and AI assistant. Never prefix these with VITE_.
AZURE_OPENAI_ENDPOINT=https://CareFlow-VPS.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Empty disables fallback. At most one extra call for seriously unreadable output.
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-6.1-sol
# The platform's key: leave empty in the repository, never commit a value. Empty means the
# AI assistant answers 503 to every request, and photo recognition stays off.
AZURE_OPENAI_API_KEY=
# Building-name search (`docs/GEOCODING.md`). The browser never calls these services itself;
# the server does, and only when the institution's `placeSearch` switch is on.
#
# `als` (default) = the government address lookup at https://www.als.gov.hk/lookup. Verified
# live on 2026-11-02: no key, `q` + `n`, and `Accept: application/json` for the answer. It
# returns premises (blocks, buildings, shops), so it covers private buildings too.
# `ha` = the Housing Authority's estate list (`docs/ha_hahdweb_dataspec.pdf`): public housing
# only, no key, and it returns the whole list rather than search results, so the server holds
# it for a day and matches the words itself.
PLACE_PROVIDER=als
ALS_ENDPOINT=https://www.als.gov.hk/lookup
# Optional. Empty sends no Authorization header, which is what the open endpoint wants and is
# not treated as "cannot search".
ALS_API_KEY=
# Only read when PLACE_PROVIDER=ha.
HA_BASE=https://data.housingauthority.gov.hk/psi/rest/criteriafilter
# Comma-separated. Residential sources by default; add shopping-centres or flatted-factory
# only if those are ever worth adding as a building.
HA_RESOURCES=prh-estates,hos-courts
