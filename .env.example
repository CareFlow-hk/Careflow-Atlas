# VPS: set your exact HTTPS origin, with no trailing slash.
APP_ORIGIN=https://atlas.example.org
WEB_PORT=8081
# Only local development may set this true with a localhost APP_ORIGIN.
ALLOW_INSECURE_LOCALHOST=false
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Server-only photo recognition. Never prefix these with VITE_.
AZURE_OPENAI_ENDPOINT=https://CareFlow-VPS.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Empty disables fallback. At most one extra call for seriously unreadable output.
AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-6.1-sol
AZURE_OPENAI_API_KEY=
