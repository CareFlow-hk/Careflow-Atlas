{
  "name": "careflow-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:generate": "node --import tsx scripts/generate-demo.ts",
    "auth:dev": "node --env-file-if-exists=.env server/index.mjs",
    "auth:manage": "node --env-file-if-exists=.env server/manage.mjs",
    "test:auth": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "^6.3.6",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
